<h1>New book</h1>

<%= form_for :book, routes.path(:create_book), method: :post do |f| %>
  <div>
	<%= f.label "Title", for: :title %>
	<%= f.text_field :title %>
  </div>

  <div>
	<%= f.label "Author", for: :author %>
	<%= f.text_field :author %>
  </div>

  <div>
	<%= f.submit "Create Book" %>
  </div>
<% end %>